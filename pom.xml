<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>io.github.mizzen-tui</groupId>
	<artifactId>mizzen</artifactId>
	<version>0.1.0</version>
	<packaging>jar</packaging>

	<name>Mizzen</name>
	<url>http://maven.apache.org</url>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
	</properties>

	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>3.8.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>


  <build>
	  <resources>
		  <resource>
			  <directory>src/main/resources</directory>
		  </resource>
		  <!-- the README and the documents it links to in the jar: the examples' desktop shows them (ReadMe) -->
		  <resource>
			  <directory>.</directory>
			  <includes>
				  <include>README.md</include>
				  <include>docs/*.md</include>
			  </includes>
		  </resource>
		  <!-- the examples' own .java in the jar too: the examples' desktop shows them (SourceFiles) -->
		  <resource>
			  <directory>src/main/java</directory>
			  <includes>
				  <include>mizzen/examples/**/*.java</include>
			  </includes>
		  </resource>
	  </resources>
	  <plugins>
	    <plugin>
		<groupId>org.apache.maven.plugins</groupId>
		<artifactId>maven-source-plugin</artifactId>
		<executions>
			<execution>
				<id>attach-sources</id>
				<goals>
					<goal>jar</goal>
				</goals>
			</execution>
		</executions>
	   </plugin>

		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-compiler-plugin</artifactId>
			<version>3.11.0</version>
			<configuration>
				<source>1.8</source>
				<target>1.8</target>
				<debug>true</debug>
				<debuglevel>source,lines,vars</debuglevel>
				<compilerArgs>
				<arg>-g</arg>
				</compilerArgs>
			</configuration>
		</plugin>

	 </plugins>
  </build>



</project>
