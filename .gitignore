/target/

# code kept out of the library (third-party / swing experiments)
/sandbox/

# personal scratch area (ad-hoc test scripts, deploy leftovers)
/scratch/

# runtime output
*.log
hs_err_pid*

# graal native-image reports if built outside target/native
/reports/

# eclipse per-workspace settings
/.settings/

# local only: Claude Code project notes (kept on each dev box, not published)
/CLAUDE.md

# local only: the owner's personal tools and notes (LOC.sh, compStats.sh, ExamplesStatusReport.txt ...), not published
/local/

# generated by the IDE's Java language server from pom.xml
/.classpath
/.project
